From b177f34c87f8aff76338bc1edfbdc2bbf1ce8208 Mon Sep 17 00:00:00 2001
From: Cameron <cclark@cloudflare.com>
Date: Fri, 13 Nov 2026 11:15:43 +0000
Subject: [PATCH] Fix tests for TSGolint patches

Use exported snapshot filesystem types in the upstream tests. Test checker-pool
constructor defaults separately from the single-run session sizing override.
Verify cached reads for present, empty, and missing files, invalidation after
underlying changes, and disabled caching. Remove the redundant parser comment.
---
 internal/project/checkerpool_test.go     |  16 ++-
 internal/project/snapshotfs_test.go      | 140 +++++++++++------------
 internal/tsoptions/tsconfigparsing.go    |   1 -
 internal/vfs/cachedvfs/cachedvfs_test.go |  69 ++++++-----
 4 files changed, 125 insertions(+), 101 deletions(-)

diff --git a/internal/project/checkerpool_test.go b/internal/project/checkerpool_test.go
index 01cb9c164..32bb8e4f9 100644
--- a/internal/project/checkerpool_test.go
+++ b/internal/project/checkerpool_test.go
@@ -2,6 +2,7 @@ package project
 
 import (
 	"context"
+	"runtime"
 	"sync/atomic"
 	"testing"
 	"testing/synctest"
@@ -203,12 +204,20 @@ func TestCheckerPoolFileAssociationCleanup(t *testing.T) {
 
 func TestCheckerPoolMinCheckers(t *testing.T) {
 	t.Parallel()
-	// Requesting maxCheckers=1 should be clamped to 2.
-	_, pool := setupCheckerPoolSession(t, CheckerPoolOptions{MaxCheckers: 1, IdleTimeout: 10 * time.Second})
+	pool := newTestCheckerPool(nil, CheckerPoolOptions{MaxCheckers: 1, IdleTimeout: 10 * time.Second})
 	assert.Equal(t, pool.opts.MaxCheckers, 2)
 	assert.Equal(t, len(pool.checkers), 2)
 }
 
+func TestCheckerPoolSessionMaxCheckers(t *testing.T) {
+	t.Parallel()
+	_, pool := setupCheckerPoolSession(t, CheckerPoolOptions{MaxCheckers: 1, IdleTimeout: 10 * time.Second})
+	want := max(runtime.GOMAXPROCS(0), 2)
+	assert.Equal(t, pool.opts.MaxCheckers, want)
+	assert.Equal(t, len(pool.checkers), want)
+	assert.Equal(t, cap(pool.querySem), want-1)
+}
+
 func TestCheckerPoolDefaultIdleTimeout(t *testing.T) {
 	t.Parallel()
 	// Zero idle timeout should default to 30s.
@@ -1031,8 +1040,7 @@ func TestCheckerPoolDoubleReleaseSafe(t *testing.T) {
 
 func TestCheckerPoolDefaultMaxCheckers(t *testing.T) {
 	t.Parallel()
-	// Zero MaxCheckers should default to 4.
-	_, pool := setupCheckerPoolSession(t, CheckerPoolOptions{MaxCheckers: 0, IdleTimeout: 10 * time.Second})
+	pool := newTestCheckerPool(nil, CheckerPoolOptions{MaxCheckers: 0, IdleTimeout: 10 * time.Second})
 	assert.Equal(t, pool.opts.MaxCheckers, 4)
 	assert.Equal(t, len(pool.checkers), 4)
 	assert.Equal(t, cap(pool.querySem), 3, "querySem capacity should be MaxCheckers-1")
