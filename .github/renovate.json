{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Boshen/renovate"],
  "timezone": "Europe/London",
  "ignorePaths": [
    "benchmarks/Containerfile",
    "shim/**/go.mod"
  ],
  "packageRules": [
    {
      "groupName": "gomod",
      "matchManagers": ["gomod"],
      "automerge": true,
      "automergeSchedule": ["at any time"],
      "schedule": ["before 9am on monday"]
    }
  ]
}
